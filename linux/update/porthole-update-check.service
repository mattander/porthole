[Unit]
Description=Check for signed Porthole application releases
Requires=porthole-update.service
After=porthole-update.service systemd-resolved.service
[Service]
Type=oneshot
User=porthole-update
Group=porthole-update
SupplementaryGroups=porthole
StateDirectory=porthole-update-cache
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -I /usr/local/lib/porthole/update/update_fetch.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/porthole-update-cache
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitCORE=0
UMask=0077
TimeoutStartSec=240
