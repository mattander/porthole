[Unit]
Description=Porthole encrypted credential writer
After=local-fs.target
Before=porthole-calendar.service
[Service]
User=root
Group=porthole-calendar
RuntimeDirectory=porthole-credentials
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 -I /usr/local/lib/porthole/credential-vault.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/etc/credstore.encrypted /run/porthole-credentials
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LimitCORE=0
UMask=0077
[Install]
WantedBy=multi-user.target
